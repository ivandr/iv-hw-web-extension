{
  "manifest_version": 3,
  "default_locale": "ru",
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "1.0.17",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Warden",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hero-wars-alliance.com/*"
      ],
      "js": ["src/i18n.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://warden.pankov.dev/*",
        "https://hw-warden.com/*",
        "https://www.hw-warden.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/marker.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js", "_locales/ru/messages.json", "_locales/en/messages.json"],
      "matches": ["https://*.hero-wars-alliance.com/*"]
    }
  ],
  "host_permissions": [
    "https://*.hero-wars-alliance.com/*",
    "https://*.pankov.dev/*",
    "https://*.hw-warden.com/*",
    "https://*.nextersglobal.com/*",
    "http://localhost/*"
  ],
  "permissions": ["storage", "cookies", "webRequest", "downloads"]
}